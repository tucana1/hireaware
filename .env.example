# ─────────────────────────────────────────────────────────────────────────────
# HireAware environment variables.
#
# EVERYTHING WORKS WITHOUT THESE. Keys only turn on extras.
# For local development, copy this file to apps/web/.env.local. Never commit real values.
# Deployed secrets go in your host's settings (e.g. Vercel → Project → Settings → Environment Variables).
#
# The browser extension gets NO secrets: anyone can unpack an extension.
# Anything starting with NEXT_PUBLIC_ or WXT_ ends up in browser code, so keep it non-secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site settings (not secret)
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # used in tipline replies ("Full guide: …")
NEXT_PUBLIC_TIPLINE_NUMBER=                    # WhatsApp number shown on /tipline, e.g. +14155238886
WXT_SITE_URL=http://localhost:3000             # links in the extension (set when building it)

# ── Claude: answers free-text questions in the chatbot, grounded in our knowledge base.
#    Without it, the chatbot answers from the local FAQ. https://console.anthropic.com → API Keys.
#    Set a monthly spend limit in the console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── WhatsApp tipline, demo: Twilio WhatsApp Sandbox.
#    https://console.twilio.com → Messaging → Try it out → Send a WhatsApp message.
#    Sandbox settings → "When a message comes in": POST https://<your-domain>/api/whatsapp
#    Testers join by sending "join <your-code>" to the sandbox number (rejoin every 3 days).
TWILIO_AUTH_TOKEN=                             # verifies X-Twilio-Signature; required in production
PUBLIC_BASE_URL=                               # e.g. https://abc.ngrok.app when behind a tunnel/proxy, so signatures match

# ── WhatsApp tipline, production: Meta WhatsApp Cloud API.
#    Callback URL https://<your-domain>/api/whatsapp/meta, subscribe to "messages".
#    Needs Meta Business verification; the test number reaches at most 5 verified recipients.
WHATSAPP_ACCESS_TOKEN=                         # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=                         # any string; Meta echoes it during webhook setup
META_APP_SECRET=                               # verifies X-Hub-Signature-256
WHATSAPP_GRAPH_VERSION=v23.0

# ── Dev only: tunnel so Twilio/Meta can reach localhost.
#    Or skip the account: cloudflared tunnel --url http://localhost:3000
NGROK_AUTHTOKEN=

# ══════════════════════════════ LATER / OPTIONAL ══════════════════════════════
# Kaggle (re-download EMSCAD; the CSV is already in the repo)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Telegram fallback channel for the tipline (not built yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Error monitoring: configure it to strip message text and phone numbers
SENTRY_DSN=
