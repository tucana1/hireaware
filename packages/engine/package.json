{
  "name": "@hireaware/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, browser-safe analysis engine: red-flag rules, the exported text classifier, score fusion, questions to ask, the risk-check chatbot flow and the tipline replies.",
  "exports": {
    ".": "./src/index.ts",
    "./default-classifier": "./src/default-classifier.ts",
