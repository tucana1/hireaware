    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "eval": "tsx scripts/eval.ts",
    "eval:external": "tsx scripts/eval-external.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
